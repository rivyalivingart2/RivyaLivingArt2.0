# Leave secrets empty here. Set real values only in Vercel or an ignored local file.
# Local next dev allows fictional preview content automatically.
# Set this only for an owner-authorized, access-protected visual preview.
# Vercel production blocks fixtures even when this flag is enabled.
RIVYA_VISUAL_PREVIEW=0

# Private /studio. Credentials never use NEXT_PUBLIC_ prefixes.
# Keep Preview and Production databases/credentials separate.
# Login is disabled until all fields are configured and scripts/studio-schema.sql is applied.
DATABASE_URL=
STUDIO_ADMIN_ID=
# At least 16 characters. Changing this and redeploying revokes all previous sessions.
STUDIO_ADMIN_PASSWORD=
# Independent cryptographically random value, at least 32 characters.
STUDIO_SESSION_SECRET=
# Choose a private reference provider; existing Vercel Preview remains supported.
BLOB_READ_WRITE_TOKEN=
RIVYA_REFERENCE_STORAGE=vercel
# For Netlify, choose exactly rivya-references-preview or rivya-references-production.
RIVYA_REFERENCE_STORE=
# Explicit application environment for eligible non-Vercel hosting.
RIVYA_ENV=
# Enable only after the final release and indexing gate is passed.
SITE_INDEXABLE=false
